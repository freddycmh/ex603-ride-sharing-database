// EX 603 Unit 1 - Entity Relationship Diagram
// Theme 1: Ride Sharing
//
// Editable source for erd.png. Regenerate with:
//     dot -Tpng erd.dot -o erd.png
//
// PK = primary key, FK = foreign key, U = unique, NN = not null
// Crow's foot notation: || = exactly one, o{ = zero or more, |{ = one or more

digraph ERD {
    graph [
        rankdir = LR,
        bgcolor = "white",
        splines = spline,
        nodesep = 0.6,
        ranksep = 1.5,
        pad = 0.4,
        fontname = "Helvetica"
    ];
    node [
        shape = plaintext,
        fontname = "Helvetica"
    ];
    edge [
        fontname = "Helvetica",
        fontsize = 11,
        color = "#3d4451",
        penwidth = 1.2,
        arrowhead = none,
        arrowtail = none,
        labeldistance = 2.4,
        labelangle = 18,
        labelfontsize = 11
    ];

    // ---------- ENTITIES ----------

    riders [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD BGCOLOR="#2f6f4e" COLSPAN="3"><FONT COLOR="white" POINT-SIZE="14"><B>riders</B></FONT><BR/><FONT COLOR="#cfe3d8" POINT-SIZE="9">actor</FONT></TD></TR>
        <TR><TD BGCOLOR="#eef4f0" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#eef4f0" ALIGN="LEFT"><B>rider_id</B></TD><TD BGCOLOR="#eef4f0" ALIGN="LEFT">BIGINT</TD></TR>
        <TR><TD ALIGN="LEFT">U</TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">phone</TD><TD ALIGN="LEFT">VARCHAR(20)</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">home_city</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">signed_up_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">BOOLEAN</TD></TR>
        </TABLE>
    >];

    drivers [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD BGCOLOR="#2f6f4e" COLSPAN="3"><FONT COLOR="white" POINT-SIZE="14"><B>drivers</B></FONT><BR/><FONT COLOR="#cfe3d8" POINT-SIZE="9">producer</FONT></TD></TR>
        <TR><TD BGCOLOR="#eef4f0" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#eef4f0" ALIGN="LEFT"><B>driver_id</B></TD><TD BGCOLOR="#eef4f0" ALIGN="LEFT">BIGINT</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
        <TR><TD ALIGN="LEFT">U</TD><TD ALIGN="LEFT">licence_number</TD><TD ALIGN="LEFT">VARCHAR(32)</TD></TR>
        <TR><TD ALIGN="LEFT">U</TD><TD ALIGN="LEFT">vehicle_plate</TD><TD ALIGN="LEFT">VARCHAR(16)</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">home_city</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">onboarded_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
        <TR><TD BGCOLOR="#fff6e0" ALIGN="LEFT">NN</TD><TD BGCOLOR="#fff6e0" ALIGN="LEFT">is_active</TD><TD BGCOLOR="#fff6e0" ALIGN="LEFT">BOOLEAN</TD></TR>
        <TR><TD BGCOLOR="#fff6e0" ALIGN="LEFT">NN</TD><TD BGCOLOR="#fff6e0" ALIGN="LEFT">rating</TD><TD BGCOLOR="#fff6e0" ALIGN="LEFT">NUMERIC(3,2)</TD></TR>
        </TABLE>
    >];

    trips [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD BGCOLOR="#8a3324" COLSPAN="3"><FONT COLOR="white" POINT-SIZE="14"><B>trips</B></FONT><BR/><FONT COLOR="#f3d9d2" POINT-SIZE="9">event &#183; high volume</FONT></TD></TR>
        <TR><TD BGCOLOR="#faeeeb" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#faeeeb" ALIGN="LEFT"><B>trip_id</B></TD><TD BGCOLOR="#faeeeb" ALIGN="LEFT">BIGINT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">rider_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">driver_id</TD><TD ALIGN="LEFT">BIGINT</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">requested_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">started_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">ended_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">trip_status</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">pickup_city</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">distance_km</TD><TD ALIGN="LEFT">NUMERIC(6,2)</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">surge_multiplier</TD><TD ALIGN="LEFT">NUMERIC(3,2)</TD></TR>
        <TR><TD BGCOLOR="#fff6e0" ALIGN="LEFT"></TD><TD BGCOLOR="#fff6e0" ALIGN="LEFT">fare_amount</TD><TD BGCOLOR="#fff6e0" ALIGN="LEFT">NUMERIC(8,2)</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">rider_rating_given</TD><TD ALIGN="LEFT">SMALLINT</TD></TR>
        </TABLE>
    >];

    driver_badges [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD BGCOLOR="#1f4e79" COLSPAN="3"><FONT COLOR="white" POINT-SIZE="14"><B>driver_badges</B></FONT><BR/><FONT COLOR="#cfe0ef" POINT-SIZE="9">catalog</FONT></TD></TR>
        <TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><B>PK</B></TD><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><B>badge_id</B></TD><TD BGCOLOR="#eaf1f7" ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT">U</TD><TD ALIGN="LEFT">badge_name</TD><TD ALIGN="LEFT">VARCHAR(60)</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT">VARCHAR(255)</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">tier</TD><TD ALIGN="LEFT">badge_tier</TD></TR>
        </TABLE>
    >];

    driver_badge_awards [label = <
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6">
        <TR><TD BGCOLOR="#1f4e79" COLSPAN="3"><FONT COLOR="white" POINT-SIZE="14"><B>driver_badge_awards</B></FONT><BR/><FONT COLOR="#cfe0ef" POINT-SIZE="9">junction</FONT></TD></TR>
        <TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><B>PK,FK</B></TD><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><B>driver_id</B></TD><TD BGCOLOR="#eaf1f7" ALIGN="LEFT">BIGINT</TD></TR>
        <TR><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><B>PK,FK</B></TD><TD BGCOLOR="#eaf1f7" ALIGN="LEFT"><B>badge_id</B></TD><TD BGCOLOR="#eaf1f7" ALIGN="LEFT">INTEGER</TD></TR>
        <TR><TD ALIGN="LEFT">NN</TD><TD ALIGN="LEFT">awarded_at</TD><TD ALIGN="LEFT">TIMESTAMPTZ</TD></TR>
        <TR><TD ALIGN="LEFT"></TD><TD ALIGN="LEFT">awarded_by</TD><TD ALIGN="LEFT">VARCHAR(80)</TD></TR>
        </TABLE>
    >];

    // ---------- RELATIONSHIPS ----------

    riders -> trips [
        taillabel = "1", headlabel = "0..N",
        label = "  requests  ",
        arrowtail = none, dir = both, arrowhead = crow
    ];

    drivers -> trips [
        taillabel = "1", headlabel = "0..N",
        label = "  fulfils  ",
        arrowtail = none, dir = both, arrowhead = crow
    ];

    drivers -> driver_badge_awards [
        taillabel = "1", headlabel = "0..N",
        label = "  earns  ",
        arrowtail = none, dir = both, arrowhead = crow
    ];

    driver_badges -> driver_badge_awards [
        taillabel = "1", headlabel = "0..N",
        label = "  classifies  ",
        arrowtail = none, dir = both, arrowhead = crow
    ];

    // ---------- LEGEND ----------
    legend [label = <
        <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" CELLPADDING="4" COLOR="#9aa5b1">
        <TR><TD ALIGN="LEFT" COLSPAN="2"><B>Legend</B></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">primary key</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">foreign key</TD></TR>
        <TR><TD ALIGN="LEFT"><B>U</B></TD><TD ALIGN="LEFT">unique constraint</TD></TR>
        <TR><TD ALIGN="LEFT"><B>NN</B></TD><TD ALIGN="LEFT">not null</TD></TR>
        <TR><TD ALIGN="LEFT">1 &#8212;&lt; 0..N</TD><TD ALIGN="LEFT">one to many</TD></TR>
        <TR><TD BGCOLOR="#fff6e0" ALIGN="LEFT">  </TD><TD ALIGN="LEFT">activity flag / filter / metric</TD></TR>
        </TABLE>
    >];
    { rank = sink; legend; }
}
